@{
    ViewData["Title"] = "Home";
}

<div class="container text-center mt-5">
    <h1 class="display-4 mb-5">Welcome to MovieSystem</h1>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        <div class="col">
            <a asp-controller="Movie" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 shadow-sm home-card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-film display-1 mb-3"></i>
                        <h5 class="card-title">Movies</h5>
                        <p class="card-text">View, add, or edit movies</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Director" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 shadow-sm home-card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-person-badge display-1 mb-3"></i>
                        <h5 class="card-title">Directors</h5>
                        <p class="card-text">See all directors</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="User" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 shadow-sm home-card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-people display-1 mb-3"></i>
                        <h5 class="card-title">Users</h5>
                        <p class="card-text">Manage users</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Rating" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 shadow-sm home-card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-star display-1 mb-3"></i>
                        <h5 class="card-title">Ratings</h5>
                        <p class="card-text">View and manage movie ratings</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>