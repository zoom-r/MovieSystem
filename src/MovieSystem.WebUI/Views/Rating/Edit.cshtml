@model MovieSystem.Application.DTOs.RatingDto

@{
    ViewData["Title"] = "Edit Rating";
}

<h1>Edit Rating</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RatingId" />

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">User</label>
        <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users"></select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MovieId" class="form-label">Movie</label>
        <select asp-for="MovieId" class="form-select" asp-items="ViewBag.Movies"></select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Score" class="form-label"></label>
        <input asp-for="Score" class="form-control" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>