@model MovieSystem.Application.DTOs.RatingDto
@{
    ViewData["Title"] = "Edit Rating";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Rating</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RatingId" />

    <div class="mb-3">
        <label asp-for="UserId" class="form-label">User</label>
        <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(ViewBag.Users, "UserId", "FullName"))"></select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MovieId" class="form-label">Movie</label>
        <select asp-for="MovieId" class="form-select" asp-items="@(new SelectList(ViewBag.Movies, "MovieId", "Title"))"></select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Score" class="form-label"></label>
        <input asp-for="Score" type="number" class="form-control" min="1" max="10" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>