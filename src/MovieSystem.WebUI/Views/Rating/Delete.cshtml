@model MovieSystem.Application.DTOs.RatingDto

@{
    ViewData["Title"] = "Delete Rating";
}

<h1>Delete Rating</h1>

<p>Are you sure you want to delete this rating?</p>

<ul>
    <li><strong>User:</strong> @Model.UserName</li>
    <li><strong>Movie ID:</strong> @Model.MovieId</li>
    <li><strong>Score:</strong> @Model.Score</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RatingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>