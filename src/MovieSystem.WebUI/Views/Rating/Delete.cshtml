@model MovieSystem.Application.DTOs.RatingDto
@{
    ViewData["Title"] = "Delete Rating";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Delete Rating</h1>

<p>Are you sure you want to delete this rating from <strong>@Model.UserName</strong> for movie ID <strong>@Model.MovieId</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RatingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>