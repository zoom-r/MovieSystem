@model IEnumerable<MovieSystem.Application.DTOs.RatingDto>

@{
    ViewData["Title"] = "Ratings";
}

<h1>Ratings</h1>

<a class="btn btn-primary mb-3" asp-action="Create">Add New Rating</a>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>User</th>
        <th>Movie</th>
        <th>Score</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var rating in Model)
    {
        <tr>
            <td>@rating.UserName</td>
            <td>@rating.MovieName</td>
            <td>@rating.Score</td>
            <td>
                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@rating.RatingId">Details</a>
                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@rating.RatingId">Edit</a>
                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@rating.RatingId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>