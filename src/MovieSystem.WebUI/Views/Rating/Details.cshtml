@model MovieSystem.Application.DTOs.RatingDto

@{
    ViewData["Title"] = "Rating Details";
}

<h1>Rating Details</h1>

<p><strong>User:</strong> @Model.UserName</p>
<p><strong>User ID: </strong> @Model.UserId</p>
<p><strong>Movie ID:</strong> @Model.MovieId</p>
<p><strong>Score:</strong> @Model.Score</p>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.RatingId">Edit</a>
<a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.RatingId">Delete</a>