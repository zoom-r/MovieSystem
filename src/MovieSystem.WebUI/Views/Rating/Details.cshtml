@model MovieSystem.Application.DTOs.RatingDto
@{
    ViewData["Title"] = "Rating Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Rating Details</h1>
<p><strong>User:</strong> @Model.UserName</p>
<p><strong>Movie ID:</strong> @Model.MovieId</p>
<p><strong>Score:</strong> @Model.Score</p>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to List</a>
<a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.RatingId })">Edit</a>
<a class="btn btn-danger" href="@Url.Action("Delete", new { id = Model.RatingId })">Delete</a>