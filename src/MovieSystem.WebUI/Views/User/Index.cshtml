@model IEnumerable<MovieSystem.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<a class="btn btn-primary mb-3" asp-action="Create">Add New User</a>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Email</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>
                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@user.UserId">Details</a>
                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@user.UserId">Edit</a>
                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@user.UserId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>