@model MovieSystem.Application.DTOs.UserDto

@{
    ViewData["Title"] = "User Details";
}

<h1>@Model.FullName</h1>

<p><strong>User ID:</strong> @Model.UserId</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToShortDateString()</p>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.UserId">Edit</a>
<a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.UserId">Delete</a>