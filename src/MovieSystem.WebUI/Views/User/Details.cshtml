@model MovieSystem.Application.DTOs.UserDto
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@Model.FullName</h1>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToShortDateString()</p>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to List</a>
<a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.UserId })">Edit</a>
<a class="btn btn-danger" href="@Url.Action("Delete", new { id = Model.UserId })">Delete</a>