@model MovieSystem.Application.DTOs.DirectorDto

@{
    ViewData["Title"] = "Director Details";
}

<h1>@Model.Name</h1>

<p><strong>Director ID:</strong> @Model.DirectorId</p>
<p><strong>Birth Date:</strong> @Model.BirthDate.ToShortDateString()</p>
<p><strong>Nationality:</strong> @Model.Nationality</p>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.DirectorId">Edit</a>
<a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.DirectorId">Delete</a>