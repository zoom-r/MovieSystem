@model MovieSystem.Application.DTOs.DirectorDto
@{
    ViewData["Title"] = "Director Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@Model.Name</h1>
<p><strong>Birth Date:</strong> @Model.BirthDate.ToShortDateString()</p>
<p><strong>Nationality:</strong> @Model.Nationality</p>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to List</a>
<a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.DirectorId })">Edit</a>
<a class="btn btn-danger" href="@Url.Action("Delete", new { id = Model.DirectorId })">Delete</a>