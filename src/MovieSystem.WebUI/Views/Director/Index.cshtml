@model IEnumerable<MovieSystem.Application.DTOs.DirectorDto>

@{
    ViewData["Title"] = "Directors";
}

<h1>Directors</h1>

<a class="btn btn-primary mb-3" asp-action="Create">Add New Director</a>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var director in Model)
    {
        <tr>
            <td>@director.Name</td>
            <td>
                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@director.DirectorId">Details</a>
                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@director.DirectorId">Edit</a>
                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@director.DirectorId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>