@model MovieSystem.Application.DTOs.DirectorDto
@{
    ViewData["Title"] = "Delete Director";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Delete Director</h1>

<p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="DirectorId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>