@model MovieSystem.Application.DTOs.DirectorDto
@{
    ViewData["Title"] = "Add Director";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Add Director</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nationality" class="form-label"></label>
        <input asp-for="Nationality" class="form-control" />
        <span asp-validation-for="Nationality" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Director</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>